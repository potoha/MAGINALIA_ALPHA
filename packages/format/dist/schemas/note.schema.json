{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maginalia.app/spec/note.schema.json", "type": "object", "additionalProperties": false,
  "required": ["type", "version", "id", "title", "path"],
  "properties": {
    "type": { "const": "note" }, "version": { "$ref": "common.schema.json#/$defs/version" },
    "id": { "$ref": "common.schema.json#/$defs/noteId" }, "title": { "type": "string", "minLength": 1 },
    "path": { "$ref": "common.schema.json#/$defs/relativePath" }
  }
}
