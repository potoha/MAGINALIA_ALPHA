{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maginalia.app/spec/project.schema.json", "type": "object", "additionalProperties": false,
  "required": ["type", "version", "id", "title"],
  "properties": {
    "type": { "const": "project" }, "version": { "$ref": "common.schema.json#/$defs/version" },
    "id": { "$ref": "common.schema.json#/$defs/projectId" }, "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" }, "visibility": { "enum": ["private", "public"] },
    "readme": { "$ref": "common.schema.json#/$defs/relativePath" }
  }
}
