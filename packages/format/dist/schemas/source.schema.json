{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maginalia.app/spec/source.schema.json", "type": "object", "additionalProperties": false,
  "required": ["type", "version", "id", "kind", "title"],
  "properties": {
    "type": { "const": "source" }, "version": { "$ref": "common.schema.json#/$defs/version" },
    "id": { "type": "string", "pattern": "^source:[0-7][0-9A-HJKMNP-TV-Z]{25}$" }, "kind": { "enum": ["book", "paper", "web"] },
    "title": { "type": "string", "minLength": 1 }, "path": { "$ref": "common.schema.json#/$defs/relativePath" }, "url": { "type": "string", "format": "uri" }
  }
}
