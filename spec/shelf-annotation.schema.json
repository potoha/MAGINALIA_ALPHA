{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maginalia.app/spec/shelf-annotation.schema.json",
  "title": "MAGINALIA Shelf Annotation v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "id",
    "source",
    "get",
    "quote"
  ],
  "properties": {
    "type": {
      "const": "annotation"
    },
    "version": {
      "const": "0.4"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/annId"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^book:[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "kind": {
          "enum": [
            "book",
            "selfpublish",
            "website",
            "bookwithoutisbn",
            "Handwritten"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mediaType",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "common.schema.json#/$defs/relativePath"
              },
              "mediaType": {
                "enum": [
                  "image/jpeg",
                  "application/pdf"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "originalName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "get": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])(?:[01][0-9]|2[0-3])(?:[0-5][0-9])$"
            },
            {
              "const": "oldversionplaceholder"
            }
          ]
        }
      }
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "isbn13": {
      "type": "string",
      "pattern": "^[0-9]{13}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        }
      },
      "minProperties": 1
    },
    "comment": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "captureImage": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "rawOcr": {
      "type": "string"
    },
    "localPath": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "deviceMetadata": {
      "type": "object"
    },
    "privateMemo": {
      "type": "string"
    },
    "unpublishedComments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "Handwritten"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "id",
              "kind",
              "files"
            ]
          }
        }
      },
      "else": {
        "anyOf": [
          {
            "required": [
              "isbn13"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ]
      }
    }
  ]
}
