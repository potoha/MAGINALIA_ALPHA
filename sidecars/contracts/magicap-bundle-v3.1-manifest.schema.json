{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maginalia.app/spec/magicap-bundle-v3.1-manifest.schema.json",
  "title": "MAGINALIA Capture Bundle manifest v3.1",
  "$comment": "Outer ZIPs use the .magicap or .magicap.zip filename suffix. Suffixes do not identify a version: inspect this root manifest's exact format and version. This shared contract follows Desktop PR #69; Capture PR #33 Draft fields are not aliases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "bundleId", "createdAt", "packages"],
  "properties": {
    "format": { "const": "maginalia-capture-bundle" },
    "version": { "const": "3.1" },
    "bundleId": { "type": "string", "pattern": "^capbundle:[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "path", "sizeBytes", "sha256", "bookId", "get", "captureIds"],
      "properties": {
        "packageId": { "type": "string", "pattern": "^capkg:[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
        "path": { "type": "string", "pattern": "^packages/[^/]+\\.magicap$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bookId": { "type": "string", "minLength": 1 },
        "get": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date"],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])(?:[01][0-9]|2[0-3])(?:[0-5][0-9])$"
            }
          }
        },
        "captureIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
        }
      }
    }
  }
}
