{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-marginalia.local/contracts/manifest-v1.schema.json",
  "title": "Digital Marginalia phone export manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportedAtMs", "book", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAtMs": { "type": "integer", "minimum": 0 },
    "book": { "$ref": "#/$defs/book" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "enum": ["openBD", "googleBooks"] },
        "subtitle": { "enum": ["openBD", "googleBooks"] },
        "authors": { "enum": ["openBD", "googleBooks"] },
        "publisher": { "enum": ["openBD", "googleBooks"] },
        "publishedDate": { "enum": ["openBD", "googleBooks"] },
        "description": { "enum": ["openBD", "googleBooks"] },
        "toc": { "enum": ["openBD", "googleBooks"] },
        "coverUrl": { "enum": ["openBD", "googleBooks"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "authors", "publisher", "publishedDate", "description", "toc", "coverUrl", "provenance"],
      "properties": {
        "title": { "$ref": "#/$defs/nullableString" },
        "subtitle": { "$ref": "#/$defs/nullableString" },
        "authors": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
        "publisher": { "$ref": "#/$defs/nullableString" },
        "publishedDate": { "$ref": "#/$defs/nullableString" },
        "description": { "$ref": "#/$defs/nullableString" },
        "toc": { "$ref": "#/$defs/nullableString" },
        "coverUrl": { "type": ["string", "null"], "maxLength": 2048, "pattern": "^https://" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isbn13", "orientation", "metadata"],
      "properties": {
        "isbn13": { "type": "string", "pattern": "^(978|979)[0-9]{10}$" },
        "orientation": { "enum": ["HORIZONTAL", "VERTICAL"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "left", "top", "right", "bottom", "kind", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^mobile:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}:[0-9]+$" },
        "left": { "type": "number", "minimum": 0, "maximum": 1 },
        "top": { "type": "number", "minimum": 0, "maximum": 1 },
        "right": { "type": "number", "minimum": 0, "maximum": 1 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 1 },
        "kind": { "enum": ["LINE", "COLUMN", "ELEMENT"] },
        "text": { "$ref": "#/$defs/nullableString" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "x", "y"],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "comment", "createdAtMs", "updatedAtMs", "strokePoints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
        "comment": { "type": "string", "maxLength": 20000 },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "updatedAtMs": { "type": "integer", "minimum": 0 },
        "strokePoints": { "type": "array", "items": { "$ref": "#/$defs/point" }, "maxItems": 10000 }
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "errorSummary", "attemptAtMs", "regions"],
      "properties": {
        "state": { "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"] },
        "errorSummary": { "$ref": "#/$defs/nullableString" },
        "attemptAtMs": { "type": ["integer", "null"], "minimum": 0 },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" }, "maxItems": 10000 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "imagePath", "width", "height", "capturedAtMs", "imageSha256", "mobileOcr", "annotations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
        "imagePath": { "type": "string", "pattern": "^pages/[A-Za-z0-9._-]+\\.jpg$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "capturedAtMs": { "type": "integer", "minimum": 0 },
        "imageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mobileOcr": { "$ref": "#/$defs/ocr" },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" }, "maxItems": 1000 }
      }
    }
  }
}
