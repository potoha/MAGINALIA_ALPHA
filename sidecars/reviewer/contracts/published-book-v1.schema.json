{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-marginalia.local/contracts/published-book-v1.schema.json",
  "title": "Digital Marginalia GitHub publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "updatedAtMs", "book", "highlights"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "updatedAtMs": { "type": "integer", "minimum": 0 },
    "book": { "$ref": "#/$defs/book" },
    "highlights": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/highlight" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"], "maxLength": 20000 },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isbn13", "title", "subtitle", "authors", "publisher", "publishedDate", "toc", "coverUrl", "provenance"],
      "properties": {
        "isbn13": { "type": "string", "pattern": "^(978|979)[0-9]{10}$" },
        "title": { "$ref": "#/$defs/nullableString" },
        "subtitle": { "$ref": "#/$defs/nullableString" },
        "authors": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 100 },
        "publisher": { "$ref": "#/$defs/nullableString" },
        "publishedDate": { "$ref": "#/$defs/nullableString" },
        "toc": { "type": ["string", "null"], "maxLength": 100000 },
        "coverUrl": { "type": ["string", "null"], "maxLength": 2048, "pattern": "^https://" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "enum": ["openBD", "googleBooks"] },
            "subtitle": { "enum": ["openBD", "googleBooks"] },
            "authors": { "enum": ["openBD", "googleBooks"] },
            "publisher": { "enum": ["openBD", "googleBooks"] },
            "publishedDate": { "enum": ["openBD", "googleBooks"] },
            "toc": { "enum": ["openBD", "googleBooks"] },
            "coverUrl": { "enum": ["openBD", "googleBooks"] }
          }
        }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quote", "contextBefore", "contextAfter", "pageLabel", "chapterLabel", "comment", "reviewedAtMs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
        "quote": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "contextBefore": { "type": "string", "maxLength": 5000 },
        "contextAfter": { "type": "string", "maxLength": 5000 },
        "pageLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "chapterLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "comment": { "type": "string", "maxLength": 10000 },
        "reviewedAtMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
